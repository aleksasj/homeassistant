services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:stable
    network_mode: host
    container_name: homeassistant
    devices:
      - /dev/ttyUSB0:/dev/ttyUSB0
    volumes:
      - "./config/ha:/config"
    ports:
      - "8123:8123"
    restart: always

  mqtt:
    image: eclipse-mosquitto
    container_name: mqtt
    volumes:
       - "./config/mqtt:/mosquitto/config:rw"
    ports:
       - "1883:1883"
       - "9001:9001"
    restart: always

  player:
    build:
      context: ./builds/player/
    container_name: player
    env_file: "config/player/.env"
    devices:
      - "/dev/snd:/dev/snd"
    privileged: true
    volumes:
      - "./config/player/:/opt/"
    restart: always
  pihole:
    container_name: pihole
    image: pihole/pihole:latest
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "80:80/tcp"
      - "443:443/tcp"
    environment:
      TZ: 'Europe/Vilnius'
      FTLCONF_webserver_api_password: 'password' #password of pi-hole
      FTLCONF_dns_listeningMode: 'ALL'
    volumes:
      - './etc-pihole:/etc/pihole'
    cap_add:
      - NET_ADMIN
      - SYS_TIME
      - SYS_NICE
    restart: unless-stopped

volumes:
  config:
  data:
  log:

networks:
  default:
    name: mqtt5-network
